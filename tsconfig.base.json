{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@language-operator/contracts": ["packages/contracts/src/index.ts"],
      "@language-operator/events": ["packages/events/src/index.ts"],
      "@language-operator/domain": ["packages/domain/src/index.ts"],
      "@language-operator/policy": ["packages/policy/src/index.ts"],
      "@language-operator/observability": ["packages/observability/src/index.ts"]
    }
  }
}
