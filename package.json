{
  "name": "language-operator",
  "version": "0.1.0",
  "private": true,
  "description": "Execution core for Language Object Level autonomous platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "test": "vitest run --coverage packages/**/*.test.ts tests/**/*.test.ts",
    "test:unit": "vitest run packages/**/*.test.ts",
    "test:integration": "vitest run tests/integration/**/*.test.ts",
    "contract:validate": "node scripts/validate-contracts.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "license:check": "node scripts/license-check.mjs",
    "docs:link-check": "node scripts/docs-link-check.mjs",
    "dev:api": "tsx watch apps/operator-api/src/server.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "tsx": "^4.19.3",
    "eslint": "^9.24.0",
    "@eslint/js": "^9.24.0",
    "typescript-eslint": "^8.30.1",
    "prettier": "^3.5.3",
    "@vitest/coverage-v8": "^3.1.1"
  }
}
